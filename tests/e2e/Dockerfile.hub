# A throwaway blackthorn hub for tests: Debian with systemd as PID 1.
FROM debian:trixie
RUN apt-get update \
 && apt-get install -y --no-install-recommends systemd systemd-sysv tmux openssh-client \
      nftables passwd util-linux procps iproute2 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
